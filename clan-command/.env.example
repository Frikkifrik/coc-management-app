# Optional Supabase client (only the public anon key belongs in the browser)
# Optional Supabase auth (sign-in screen: email + password, magic link, Discord OAuth).
# Leave both blank and the app runs entirely on the local dataset; the sign-in screen then
# says Supabase is unavailable instead of failing silently.
#
# To enable Discord:
#   1. Discord Developer Portal -> your application -> OAuth2 -> add a redirect URI of
#      <your origin>/            (e.g. https://your.host/)
#   2. Copy the Discord client ID + secret into Supabase -> Authentication -> Providers -> Discord
#   3. In Supabase -> Authentication -> URL Configuration, add <your origin>/ to the redirect allowlist
# The button calls supabase.auth.signInWithOAuth({ provider: 'discord' }) and Supabase redirects
# back to the app root, where detectSessionInUrl picks the session up from the URL fragment.
#
# NOTE: Supabase sign-in does NOT by itself unlock live Supercell lookups. Those go through this
# app's own server (/api/supercell/*), which gates on a session cookie issued by POST /api/auth/login
# against the local SQLite user table. The server does not verify Supabase tokens. Use the
# "Clan server" tab on the sign-in screen for that, or add Supabase token verification server-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional live Supercell API adapter. Keep secrets server-side; never prefix these with VITE_.
# Provide a trusted, allowlisted egress proxy with a stable public IPv4 address registered in the
# Supercell developer portal. Requests are only made from the server and are proxied through it.
SUPERCELL_API_KEY=
SUPERCELL_STATIC_IP_PROXY_URL=

# Existing Clan Command local database settings
CLANCMD_PORT=4173
DEMO_MODE=true
# CLANCMD_APP_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# ==========================================
# CLAN COMMAND ENVIRONMENT CONFIGURATION
# ==========================================

# Supercell Developer API Token (from developer.clashofclans.com)
SUPERCELL_API_KEY=your_token_here

# Static IP Proxy URL (Required if server IP changes, e.g. http://user:pass@proxy.example.com:8080)
# Leave blank if developing locally or if server has a fixed public IP added to Supercell key whitelist
SUPERCELL_STATIC_IP_PROXY_URL=

# Base URL for Supercell API (Defaults to https://api.clashofclans.com/v1)
SUPERCELL_API_BASE_URL=https://api.clashofclans.com/v1
